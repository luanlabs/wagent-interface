# ---------------------------------------------------------------------------
# Wagent Interface environment variables
#
# Every variable is prefixed with NEXT_PUBLIC_ and is therefore inlined into
# the client bundle AT BUILD TIME. Set them before `npm run build` (locally in
# .env.local, or as Docker build args). Changing them requires a rebuild.
# ---------------------------------------------------------------------------

# Base URL of the Wagent backend API (REQUIRED). Example: https://api.wagent.app
NEXT_PUBLIC_API=

# Blux app id from the Blux dashboard. The app secret stays on the API only.
NEXT_PUBLIC_BLUX_APP_ID=ttaynetjysq6ko7fypb7

# ---- Firebase Cloud Messaging (web push) ----------------------------------
# Optional: push notifications degrade gracefully if these are unset.
# NOTE: the background service worker (public/firebase-messaging-sw.js) cannot
# read env vars, so its Firebase config must be kept in sync manually.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Web Push VAPID public key (Firebase Console → Cloud Messaging → Web Push certificates)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
